{
  "name": "desapego-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST simulada do desaPego (json-server). No sistema final, este lugar é do backend NestJS.",
  "scripts": {
    "dev": "npm run prepare-db && json-server db.json --port 3001",
    "prepare-db": "node -e \"const f=require('fs');if(!f.existsSync('db.json'))f.copyFileSync('db.seed.json','db.json')\"",
    "reset-db": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\""
  },
  "devDependencies": {
    "json-server": "^1.0.0-beta.15"
  }
}
