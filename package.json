{
  "name": "ceub-projeto-seminario-web-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare-db && concurrently -n api,web -c magenta,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "npm run prepare-db && json-server db.json --port 3001",
    "prepare-db": "node -e \"const f=require('fs');if(!f.existsSync('db.json'))f.copyFileSync('db.seed.json','db.json')\"",
    "reset-db": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
